{
  "name": "health-tracker-backend",
  "version": "1.0.0",
  "description": "Node.js backend for health-tracker application",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --ignore node_modules --ignore dist --ignore logs server.js",
    "build": "mkdir -p dist && cp -r *.js db.js middleware models routes prometheus-metrics dist/ && cp package*.json dist/",
    "test": "jest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.5.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "semver": "7.5.2"
  }
}
