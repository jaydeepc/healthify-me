# Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings under "Environment Variables"

# MongoDB Connection String (REQUIRED)
# Get this from MongoDB Atlas or your MongoDB provider
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/healthtracker?retryWrites=true&w=majority


# Port Configuration (REQUIRED)
FRONTEND_PORT=16972
BACKEND_PORT=16973

# Backend URL for Frontend API Calls (REQUIRED)
# Set this to your Vercel backend deployment URL
# Example: https://your-backend.vercel.app
VITE_BACKEND_URL=https://your-backend.vercel.app

# CORS Origin (REQUIRED)
# Set this to your Vercel deployment URL
# Example: https://your-app.vercel.app or https://your-custom-domain.com
CORS_ORIGIN=https://your-app.vercel.app

# Optional: External API Service Base URL
# Only needed if you're integrating with external APIs
VITE_ORCHESTRATOR_SERVICE_BASE_URL=

# Optional: User Space Base Path
# Only needed if you're using AWS SSM Parameter Store
USERSPACE_BASE_PATH=
