# Frontend-specific variables (must have VITE_ prefix)
VITE_API_URL={{APP_URL_PREFIX}}/api
VITE_APP_TITLE={{REPO_NAME}}
VITE_DEBUG_MODE=true
VITE_TEST="{{REPO_NAME}}_test"

# Port configurations. 
# Please do not change the ports manually, these are bind to the application and cannot be changed at runtime.
# You might face re-direction issue when application starts.
FRONTEND_PORT={{FRONTEND_PORT}}
BACKEND_PORT={{BACKEND_PORT}}

# Backend-specific variables
NODE_ENV=development
LOG_LEVEL=debug
TEST="{{REPO_NAME}}_test"

# CORS settings
CORS_ORIGIN=http://localhost:${FRONTEND_PORT}

#MongoDB database name
DB_NAME={{DB_NAME}}

#UserSpace path
USERSPACE_BASE_PATH=/ext-data/code-server

VITE_ORCHESTRATOR_SERVICE_BASE_URL=https://dev1.piramalfinance.com/api/byot/orchestrator
ORCHESTRATOR_SERVICE_BASE_URL=https://dev1.piramalfinance.com/api/byot/orchestrator
VITE_AUTH_LOGIN_API_ENDPOINT=/login/sso
VITE_AUTH_LOGOUT_API_ENDPOINT=/logout