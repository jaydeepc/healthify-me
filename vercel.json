{
  "version": 2,
  "buildCommand": "cd backend && npm run build",
  "outputDirectory": "backend/dist",
  "builds": [
    {
      "src": "backend/dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health-tracker/api/(.*)",
      "dest": "backend/dist/server.js"
    },
    {
      "src": "/health-tracker/api/actuator/(.*)",
      "dest": "backend/dist/server.js"
    }
  ]
}
